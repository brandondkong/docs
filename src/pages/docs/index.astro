---
import { getCollection } from 'astro:content';
import { buildNav, flattenNav } from '../../lib/nav';

const entries = await getCollection('docs', ({ data }) => !data.hidden);
const nav = buildNav(entries);
const flat = flattenNav(nav);
const first = flat[0];

if (first) {
    return Astro.redirect(first.href, 301);
}

return Astro.redirect('/', 301);
---
