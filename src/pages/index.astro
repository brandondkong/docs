---
import '../styles/global.css';
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import { buildNav, flattenNav } from '../lib/nav';

const entries = await getCollection('docs', ({ data }) => !data.hidden);
const firstDocHref = flattenNav(buildNav(entries))[0]?.href ?? import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <script is:inline>
            (function () {
                var stored = localStorage.getItem('docs-theme');
                var prefersDark = window.matchMedia(
                    '(prefers-color-scheme: dark)',
                ).matches;
                var theme = stored ?? (prefersDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            })();
        </script>

        <title>{SITE.name} — Documentation</title>
        <meta name="description" content={SITE.description} />
        <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    </head>
    <body class="bg-background text-foreground min-h-svh flex flex-col">
        <!-- Minimal nav -->
        <header class="sticky top-0 z-50 flex h-16 items-center border-b border-border bg-background/95 backdrop-blur-sm px-4 sm:px-10">
            <a href={import.meta.env.BASE_URL} class="text-base font-bold tracking-tight uppercase min-w-0 truncate">
                {SITE.name}
            </a>
            <nav class="ml-auto flex shrink-0 items-center gap-3 sm:gap-4 pl-3 text-sm text-muted">
                <a
                    href={firstDocHref}
                    class="hover:text-foreground transition-colors duration-(--duration-fast)"
                >
                    Docs
                </a>
                <a
                    href={SITE.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 hover:text-foreground transition-colors duration-(--duration-fast)"
                    aria-label="View on GitHub"
                >
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    <span class="hidden sm:inline">GitHub</span>
                </a>
            </nav>
        </header>

        <!-- Hero -->
        <main class="flex-1 flex flex-col items-start justify-center px-6 sm:px-16 md:px-24 py-16 sm:py-24 max-w-4xl mx-auto w-full min-w-0">
            <div class="flex items-center gap-2 mb-8">
                <span class="text-xs font-medium uppercase tracking-widest text-subtle border border-border px-2 py-1">
                    v{SITE.version}
                </span>
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.05] tracking-tight mb-6 break-words max-w-full">
                {SITE.name}
            </h1>

            <p class="text-lg sm:text-xl text-muted leading-relaxed mb-10 max-w-xl">
                {SITE.description}
            </p>

            <div class="flex flex-wrap items-center gap-3">
                <a
                    href={firstDocHref}
                    class="px-6 py-3 text-sm font-medium bg-foreground text-background hover:opacity-80 transition-opacity duration-(--duration-fast)"
                >
                    Get Started →
                </a>
                <a
                    href={SITE.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-6 py-3 text-sm font-medium border border-border hover:border-foreground transition-colors duration-(--duration-fast) text-foreground"
                >
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    View on GitHub
                </a>
            </div>
        </main>

        <!-- Footer -->
        <footer class="border-t border-border px-6 sm:px-10 py-5 flex items-center justify-between text-xs text-subtle">
            <span>{SITE.name} docs</span>
            <a
                href={SITE.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 hover:text-foreground transition-colors duration-(--duration-fast)"
            >
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                GitHub
            </a>
        </footer>
    </body>
</html>
