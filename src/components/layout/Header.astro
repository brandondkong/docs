---
import { SITE } from '../../config';

const githubIcon = `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`;
---

<header
    class="sticky top-0 z-50 flex h-16 w-full items-center border-b border-border bg-background/95 backdrop-blur-sm"
    data-pagefind-ignore
>
    <div class="flex w-full items-center gap-3 px-4 sm:px-6">
        <!-- Mobile: sidebar toggle -->
        <button
            id="sidebar-toggle"
            class="flex h-9 w-9 shrink-0 items-center justify-center text-muted hover:text-foreground transition-colors duration-(--duration-fast) md:hidden"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="sidebar"
        >
            <svg id="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <line x1="2" y1="5" x2="16" y2="5" stroke="currentColor" stroke-width="1.5"/>
                <line x1="2" y1="9" x2="16" y2="9" stroke="currentColor" stroke-width="1.5"/>
                <line x1="2" y1="13" x2="16" y2="13" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <svg id="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden" aria-hidden="true">
                <line x1="3" y1="3" x2="15" y2="15" stroke="currentColor" stroke-width="1.5"/>
                <line x1="15" y1="3" x2="3" y2="15" stroke="currentColor" stroke-width="1.5"/>
            </svg>
        </button>

        <!-- Logo -->
        <a href="/" class="text-base font-bold tracking-tight uppercase shrink-0 mr-auto md:mr-0">
            {SITE.name}
        </a>

        <!-- Desktop: version badge -->
        <span class="hidden md:inline-flex items-center px-2 py-0.5 text-xs font-medium text-muted bg-surface border border-border ml-2 mr-auto">
            v{SITE.version}
        </span>

        <!-- Search trigger -->
        <button
            id="search-trigger"
            class="flex h-8 items-center gap-2 px-3 text-sm text-muted bg-surface border border-border hover:border-foreground transition-colors duration-(--duration-fast) cursor-text"
            aria-label="Search documentation"
        >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.25"/>
                <line x1="9.5" y1="9.5" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <span class="hidden sm:inline text-muted">Search</span>
            <kbd class="hidden sm:inline-flex items-center gap-0.5 text-xs text-subtle border border-border px-1 py-0.5 leading-none">
                ⌘K
            </kbd>
        </button>

        <!-- Theme toggle -->
        <button
            id="theme-toggle"
            class="flex h-8 items-center gap-1.5 px-2.5 text-sm text-muted border border-border hover:border-foreground hover:text-foreground transition-colors duration-(--duration-fast)"
            aria-label="Toggle theme"
        >
            <!-- Sun icon — visible in dark mode (switch to light) -->
            <svg id="icon-sun" class="hidden shrink-0" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.25"/>
                <line x1="8" y1="1" x2="8" y2="2.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="8" y1="13.5" x2="8" y2="15" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="1" y1="8" x2="2.5" y2="8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="13.5" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="3.05" y1="3.05" x2="4.11" y2="4.11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="11.89" y1="11.89" x2="12.95" y2="12.95" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="12.95" y1="3.05" x2="11.89" y2="4.11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <line x1="4.11" y1="11.89" x2="3.05" y2="12.95" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <!-- Moon icon — visible in light mode (switch to dark) -->
            <svg id="icon-moon" class="shrink-0" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
            </svg>
            <span id="theme-label" class="hidden sm:inline text-xs leading-none">Dark</span>
        </button>

        <!-- GitHub link -->
        <a
            href={SITE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 items-center gap-1.5 px-2.5 text-sm text-muted border border-border hover:border-foreground hover:text-foreground transition-colors duration-(--duration-fast)"
            aria-label="View on GitHub"
        >
            <Fragment set:html={githubIcon} />
            <span class="hidden sm:inline text-xs leading-none">GitHub</span>
        </a>
    </div>
</header>

<script>
    const sidebarToggle = document.getElementById('sidebar-toggle')!;
    const sidebar = document.getElementById('sidebar')!;
    const backdrop = document.getElementById('sidebar-backdrop')!;
    const iconMenu = document.getElementById('icon-menu')!;
    const iconClose = document.getElementById('icon-close')!;
    const themeToggle = document.getElementById('theme-toggle')!;
    const iconSun = document.getElementById('icon-sun')!;
    const iconMoon = document.getElementById('icon-moon')!;
    const themeLabel = document.getElementById('theme-label')!;
    const searchTrigger = document.getElementById('search-trigger')!;
    const searchModal = document.getElementById('search-modal')!;

    let sidebarOpen = false;

    function openSidebar() {
        sidebarOpen = true;
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
        sidebarToggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('overflow-hidden');
    }

    function closeSidebar() {
        sidebarOpen = false;
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        sidebarToggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
    }

    sidebarToggle.addEventListener('click', () => (sidebarOpen ? closeSidebar() : openSidebar()));
    backdrop.addEventListener('click', closeSidebar);
    sidebar.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => { if (window.innerWidth < 768) closeSidebar(); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sidebarOpen) closeSidebar(); });

    // Theme
    function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('docs-theme', theme);
        if (theme === 'dark') {
            iconSun.classList.remove('hidden');
            iconMoon.classList.add('hidden');
            themeLabel.textContent = 'Light';
        } else {
            iconSun.classList.add('hidden');
            iconMoon.classList.remove('hidden');
            themeLabel.textContent = 'Dark';
        }
    }

    applyTheme(document.documentElement.getAttribute('data-theme') ?? 'light');

    themeToggle.addEventListener('click', () => {
        applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // Search
    function openSearch() {
        searchModal.removeAttribute('hidden');
        searchModal.querySelector<HTMLInputElement>('#search-input')?.focus();
    }
    searchTrigger.addEventListener('click', openSearch);
    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    });
</script>
