---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
---

<div class="toc">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-subtle">
        On This Page
    </p>
    <ul class="flex flex-col gap-2.5" id="toc-list">
        {
            headings.map((heading) => (
                <li>
                    <a
                        href={`#${heading.slug}`}
                        data-toc-item
                        data-toc-slug={heading.slug}
                        class={[
                            'block text-sm text-muted hover:text-foreground transition-colors duration-(--duration-fast) leading-snug',
                            heading.depth === 3 ? 'pl-3' : '',
                        ].join(' ')}
                    >
                        {heading.text.replace(/ #$/, '')}
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<script>
    const tocItems = document.querySelectorAll<HTMLAnchorElement>('[data-toc-item]');

    if (tocItems.length > 0) {
        const activeClass = ['text-foreground', 'font-medium'];
        const inactiveClass = ['text-muted'];
        let activeItem: HTMLAnchorElement | null = null;

        function setActive(item: HTMLAnchorElement | null) {
            if (activeItem === item) return;

            if (activeItem) {
                activeItem.classList.remove(...activeClass);
                activeItem.classList.add(...inactiveClass);
            }

            activeItem = item;

            if (activeItem) {
                activeItem.classList.add(...activeClass);
                activeItem.classList.remove(...inactiveClass);
            }
        }

        // Use the main scroll container, not window
        const scrollRoot = document.getElementById('main');

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        const tocItem = document.querySelector<HTMLAnchorElement>(
                            `[data-toc-slug="${id}"]`,
                        );
                        if (tocItem) setActive(tocItem);
                    }
                }
            },
            {
                root: scrollRoot,
                rootMargin: '-80px 0px -60% 0px',
                threshold: 0,
            },
        );

        tocItems.forEach((item) => {
            const id = item.dataset.tocSlug;
            const target = id ? document.getElementById(id) : null;
            if (target) observer.observe(target);
        });
    }
</script>
