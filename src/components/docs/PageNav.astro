---
import type { NavItem } from '../../lib/nav';

interface Props {
    prev: NavItem | null;
    next: NavItem | null;
}

const { prev, next } = Astro.props;
---

{
    (prev || next) && (
        <nav
            aria-label="Page navigation"
            class="mt-12 flex items-stretch justify-between gap-4 border-t border-border pt-8"
        >
            {prev ? (
                <a
                    href={prev.href}
                    class="group flex flex-1 flex-col gap-1 border border-border px-5 py-4 hover:border-foreground transition-colors duration-(--duration-fast)"
                >
                    <span class="text-xs uppercase tracking-widest text-subtle">
                        Previous
                    </span>
                    <span class="text-sm font-medium text-foreground flex items-center gap-1.5">
                        <svg
                            class="shrink-0 transition-transform duration-(--duration-fast) group-hover:-translate-x-0.5"
                            width="14"
                            height="14"
                            viewBox="0 0 14 14"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M9 2L4 7l5 5"
                                stroke="currentColor"
                                stroke-width="1.25"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                        {prev.title}
                    </span>
                </a>
            ) : (
                <div class="flex-1" />
            )}

            {next && (
                <a
                    href={next.href}
                    class="group flex flex-1 flex-col gap-1 border border-border px-5 py-4 hover:border-foreground transition-colors duration-(--duration-fast) items-end text-right"
                >
                    <span class="text-xs uppercase tracking-widest text-subtle">
                        Next
                    </span>
                    <span class="text-sm font-medium text-foreground flex items-center gap-1.5">
                        {next.title}
                        <svg
                            class="shrink-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5"
                            width="14"
                            height="14"
                            viewBox="0 0 14 14"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M5 2l5 5-5 5"
                                stroke="currentColor"
                                stroke-width="1.25"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </a>
            )}
        </nav>
    )
}
